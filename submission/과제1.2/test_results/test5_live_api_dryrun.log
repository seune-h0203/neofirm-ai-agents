인증: Bearer k-Eb... (환경변수)

--- 명령어 ---
$env:GCS_PULSE_API_URL = "https://api.1000.school"
$env:GCS_PULSE_API_KEY = "<키 환경변수>"
python book_room_event.py --title "GCS Live Test" --start "2026-10-15T10:00:00+09:00" \
  --end "2026-10-15T11:00:00+09:00" --attendees elice0105412@gmail.com \
  --room-preference "small" --dry-run --json

