--- API 스펙 확인 (openapi.json) ---
POST /meeting-rooms/{room_id}/reservations
  body: { start_at: datetime, end_at: datetime, purpose?: string }
  response: { id, meeting_room_id, reserved_by_user_id, reserved_by_name, start_at, end_at, purpose, can_cancel }
DELETE /meeting-rooms/reservations/{reservation_id}
  response: { message: string }
